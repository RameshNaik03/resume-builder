{
  "name": "resume-builder-server",
  "version": "1.0.0",
  "description": "Backend API for the full stack resume builder",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "dev": "docker compose up -d --wait && nodemon server.js",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "start": "node server.js",
    "lint": "oxlint --deny-warnings",
    "cloudinary:retry": "node scripts/retryDeletions.js",
    "test": "node --test \"tests/*.test.js\"",
    "test:import-regression": "node --test tests/import-regression.test.js",
    "test:roundtrip": "node --test e2e/roundtrip.test.js",
    "test:e2e": "node --test --test-concurrency=1 e2e/browser-cleanup.test.js e2e/ats-checker.test.js e2e/ats-review.test.js e2e/fit-one-page.test.js e2e/tailor.test.js e2e/coverLetter.test.js e2e/pdf-download.test.js e2e/import-original.test.js e2e/no-overflow.test.js e2e/app-shell.test.js e2e/auth-pages.test.js",
    "screenshots": "node e2e/screenshots.js"
  },
  "author": "Ramesh Naik",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.3",
    "jszip": "3.10.2",
    "mammoth": "^1.13.0",
    "mongoose": "^9.11.2",
    "multer": "^2.4.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "5.4.296",
    "resend": "^6.34.1",
    "sanitize-html": "^2.18.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "oxlint": "^1.88.0",
    "puppeteer-core": "^24.43.1"
  }
}
