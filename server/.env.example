PORT=5000
# Local development: MongoDB runs in Docker (started by `pnpm run dev`)
MONGO_URI=mongodb://127.0.0.1:27017/resume-builder
# Production: use your MongoDB Atlas connection string instead
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster-name>.xxxxx.mongodb.net/resume-builder?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_string
CLIENT_URL=http://localhost:5173
# Optional: Resend API key for sending "forgot password" emails (https://resend.com/api-keys).
# Leave empty in development: the reset link is printed in the server terminal instead.
RESEND_API_KEY=
# Sender address. For testing use onboarding@resend.dev (it can only send to the email you
# signed up to Resend with). For real users, verify your own domain in Resend and use it here.
EMAIL_FROM="Resume Builder <onboarding@resend.dev>"
# Set to "production" on your hosting platform (hides error details from users)
NODE_ENV=development
# Optional: Cloudinary keys for profile photos (free tier: https://cloudinary.com/users/register_free).
# Find all three on the Cloudinary dashboard. Leave empty to turn photo uploads off.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: Claude API key for smarter resume imports and AI feedback in the ATS checker
# (https://platform.claude.com). Leave empty to use the free rule-based versions instead.
ANTHROPIC_API_KEY=
